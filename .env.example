# Copy to .env and fill in your own values. NEVER commit the real .env file.

# --- Lovable Cloud / Supabase (client-side, safe to expose) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Supabase (server-side) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your-project-id"
# Secret. Only needed for privileged server operations.
SUPABASE_SERVICE_ROLE_KEY=""

# --- eSewa (leave unset to use the public test environment EPAYTEST) ---
ESEWA_PRODUCT_CODE=""
ESEWA_SECRET_KEY=""

# --- Khalti (required for the official "Pay with Khalti" flow) ---
KHALTI_SECRET_KEY=""
KHALTI_ENV="test" # or "live"

# --- Stripe (optional card payments) ---
STRIPE_SECRET_KEY=""
